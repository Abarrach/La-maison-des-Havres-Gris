{
  "_note": "Ce que DuneExtract sort du jeu, et où. Les chemins vides sont déduits des réglages FModel (dossier de paks, .usmap). La sortie imite EXACTEMENT l'arborescence d'export de FModel : les scripts tools/build_*.js ne voient aucune différence.",
  "_aes": "Clé de déchiffrement des paks. Laissée VIDE exprès : elle est lue dans les réglages FModel au besoin, et n'a pas sa place dans un dépôt git. Passer --aes 0x… si le montage échoue.",

  "paks": "",
  "usmap": "",
  "mapstructtypes": "../mapstructtypes.json",
  "out": "J:/Download/Fmodel/Output/Exports",
  "locale": "fr",
  "aes": "",

  "meshes": {
    "_note": "Export glTF des meshes du Constructeur (--meshes). Le nom de sortie est le nom d'asset, exactement ce que planner_pieces.json référence. Par défaut on ne refait pas un .glb déjà présent (--mesh-force pour forcer, --mesh-filter <texte> pour se limiter à un set).",
    "catalogue": "../../base_pieces_v3.json",
    "out": "../../models"
  },

  "targets": [
    {
      "id": "recipes",
      "path": "Systems/Crafting/DT_ItemsCraftingRecipes",
      "mode": "file",
      "note": "recettes de craft (ingrédients, sorties, qualités)"
    },
    {
      "id": "base_items",
      "path": "Systems/Items/CDT_BaseItems",
      "mode": "file",
      "note": "descriptions FR + tags des objets (sert aussi aux plans)"
    },
    {
      "id": "armor",
      "path": "Systems/Items/DT_ArmorItemTable",
      "mode": "file",
      "note": "valeur d'armure + mitigations"
    },
    {
      "id": "augments",
      "path": "Systems/Items/DT_ItemTable_Augments",
      "mode": "file",
      "note": "table des augments"
    },
    {
      "id": "upgrades",
      "path": "Systems/Items/Upgrades/",
      "mode": "dir",
      "note": "effets chiffrés par qualité (DataAssets)"
    },
    {
      "id": "quality",
      "path": "Systems/Items/Quality/",
      "mode": "dir",
      "note": "scaling par grade (courbes CF_*PerQuality)"
    },
    {
      "id": "loottables",
      "path": "Systems/LootTables/",
      "mode": "dir",
      "note": "butin : lieux nommés + conteneurs à tags"
    },
    {
      "id": "looting",
      "path": "Systems/Looting/",
      "mode": "dir",
      "note": "configuration du butin"
    },
    {
      "id": "localization_items",
      "path": "Localization/ST_Localization_Items",
      "mode": "file",
      "note": "pont nom de plan ↔ identifiant"
    },
    {
      "id": "building",
      "path": "Systems/Building/Data/",
      "mode": "dir",
      "note": "catalogue du Constructeur (alimente base_pieces_v3)"
    },
    {
      "id": "vehicles",
      "path": "Systems/Vehicles/",
      "mode": "dir",
      "note": "véhicules (alimente base_pieces_v3)"
    },
    {
      "id": "landsraad",
      "path": "Systems/MnemonicRecall/Data/JourneyCards/LandsraadContracts/",
      "mode": "dir",
      "note": "missions Landsraad (alimente landsraad_data.json)"
    },
    {
      "id": "landsraad_pools",
      "path": "Systems/Landsraad/VotingBlock/",
      "mode": "dir",
      "note": "pools de missions Landsraad, un par spécialité"
    },
    {
      "id": "maps_info",
      "path": "Maps/DT_MapsInfo",
      "mode": "file",
      "note": "nom FR des lieux + taille de groupe conseillée"
    },
    {
      "id": "progression",
      "path": "Systems/Progression/",
      "mode": "dir",
      "note": "compétences : DT_TrainingModules, DT_Perks, effets (GASEffects) et courbes (alimente stuff_skills.json)"
    },
    {
      "id": "ability_tuning",
      "path": "GadgetsAbilities/CT_",
      "mode": "dir",
      "note": "courbes des capacités (CT_AbilityTuning) et d'affichage (CT_AbilityStatDisplay)"
    }
  ],

  "_targets_differes": [
    {
      "id": "maps_biomes",
      "path": "Maps/Biomes/",
      "mode": "dir",
      "note": "LOURD (~16 000 assets) : lieux réels des plans uniques. À activer en le déplaçant dans targets, ou via --only maps_biomes si réintégré."
    }
  ]
}
